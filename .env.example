# Translation provider for News Wire: "deepl" or "openai"
NEWS_WIRE_TRANSLATION_PROVIDER=deepl

# Set to "1" to require translation (script will error if API key is missing)
NEWS_WIRE_REQUIRE_TRANSLATION=0

# DeepL translation settings
DEEPL_API_KEY=your_deepl_api_key_here
DEEPL_TARGET_LANG=ZH

# OpenAI translation settings (used when NEWS_WIRE_TRANSLATION_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
NEWS_WIRE_TRANSLATION_MODEL=gpt-4o-mini

# Python binary path (defaults to python3)
# PYTHON=python3
# PYTHON3=python3

# Key metrics sync options
KEY_METRICS_CHECK_SOURCES=0
KEY_METRICS_STRICT_SOURCES=0
